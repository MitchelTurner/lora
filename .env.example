# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://lora:lora@localhost:5432/lora
# Redis for BullMQ
REDIS_URL=redis://localhost:6379
# S3-compatible storage (MinIO locally; R2/S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lora-forge
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Vision captions for dataset photos. Leave the key blank to keep Suggest with AI off.
OPENAI_API_KEY=
# Optional OpenAI-compatible base, including /v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CAPTION_MODEL=gpt-4o-mini
# Training provider: mock | runpod
TRAINING_PROVIDER=mock
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Shared secret for HMAC-signed worker webhooks
WEBHOOK_HMAC_SECRET=change-me
# Public base URL of the API (used to build webhook URLs)
API_PUBLIC_URL=http://localhost:3000
# Days before datasets are deleted from storage
DATASET_RETENTION_DAYS=7
# Per-user limits
MAX_IMAGES_PER_PROJECT=50
MAX_CONCURRENT_JOBS=1
